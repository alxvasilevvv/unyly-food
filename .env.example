# Copy to .env and fill in. Never commit real values.
NODE_ENV=production
PORT=3000
# unyly.org already serves another product: pick hosts deliberately (docs/operations.md).
# Caddy hosts
WEB_HOST=food.unyly.org
# MCP_HOST=mcp-food.unyly.org   (only with the optional second Caddy site block)
# Public origin of the website; also the OAuth issuer.
WEB_ORIGIN=https://food.unyly.org
# Canonical MCP resource URL (token audience). Must be https in production.
MCP_RESOURCE_URL=https://food.unyly.org/mcp
# Required in production; the app refuses to start while it contains CHANGE_ME.
DATABASE_URL=postgres://unyly:CHANGE_ME@db:5432/unyly
POSTGRES_PASSWORD=CHANGE_ME
# Reverse proxies in front of the app, used for the client IP (rate limits): a hop count (1 = Caddy
# only) or a comma-separated list of proxy IPs/CIDRs (e.g. 172.18.0.0/16). Never "trust all".
# Default in production: 1. "true" is read as 1 for backward compatibility.
TRUST_PROXY=1
# Random secret, at least 32 characters (openssl rand -hex 32). Placeholders are refused in production.
DEMO_WEBHOOK_SECRET=CHANGE_ME
# Email login codes: smtp, disabled (passkeys only) or console (development only; logs no content).
MAIL_MODE=smtp
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Unyly <no-reply@unyly.org>
SUPPORT_EMAIL=support@unyly.org
# Must be false in production
DEV_ECHO_LOGIN_CODE=false
# Global kill switch for NEW orders (status reads keep working). Per-mode switch lives in the DB (npm run kill-switch).
SUBMISSIONS_ENABLED=true
PROVIDER_TIMEOUT_MS=10000
# Step-up: orders at or above the threshold need a fresh passkey on the confirmation page (users with a passkey).
# on (default) or off. Per-currency thresholds in minor units override the defaults (about 2,000 THB / 55 USD):
STEP_UP=on
# STEP_UP_THRESHOLD_THB=200000
# STEP_UP_THRESHOLD_SGD=7500
# STEP_UP_THRESHOLD_MYR=25000
# STEP_UP_THRESHOLD_IDR=90000000
# STEP_UP_THRESHOLD_VND=1400000
# STEP_UP_THRESHOLD_PHP=320000
# STEP_UP_THRESHOLD_USD=5500
# STEP_UP_THRESHOLD_MMK=20000000
# Login with Grab (GrabID OIDC). off by default. Register the redirect URI with the GrabID team.
GRABID=off
# sandbox (partner-api.stg-myteksi.com) or production (partner-api.grab.com)
GRABID_ENV=sandbox
GRABID_CLIENT_ID=
# Inject from a secret manager in production (Grab requires secrets outside config files).
GRABID_CLIENT_SECRET=
# Default: {WEB_ORIGIN}/auth/grab/callback
# GRABID_REDIRECT_URI=
# Override the discovery host (tests, staging stands only)
# GRABID_ISSUER=
# on (default): also verify the ID token with Grab's token_info endpoint
# GRABID_VERIFY_ENDPOINT=on
# GrabPay One-time Charge (cashless GrabExpress payments). off by default.
# Register with Grab: redirect https://unyly-food.unyly.org/pay/grab/callback, webhook https://unyly-food.unyly.org/webhooks/grabpay
GRABPAY=off
# sandbox (partner-api.stg-myteksi.com) or production (partner-api.grab.com)
GRABPAY_ENV=sandbox
GRABPAY_PARTNER_ID=
# Inject secrets from a secret manager in production.
GRABPAY_PARTNER_SECRET=
GRABPAY_MERCHANT_ID=
GRABPAY_CLIENT_ID=
GRABPAY_CLIENT_SECRET=
# Currency of the merchant account: THB (default), SGD, MYR, PHP, IDR
# GRABPAY_CURRENCY=THB
# Default: {WEB_ORIGIN}/pay/grab/callback
# GRABPAY_REDIRECT_URI=
# Encrypts stored Grab tokens (openssl rand -hex 32); derived from GRABPAY_CLIENT_SECRET when unset
# GRABPAY_TOKEN_KEY=
# Override the Grab host (tests, staging stands only)
# GRABPAY_API_BASE=
# Demo only: speed of simulated delivery (1 = real time, must be > 0). Numeric values are validated at startup.
DEMO_TIME_SCALE=1
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_SEC=2592000
RUN_JOBS=true
ACME_EMAIL=ops@unyly.org

# Optional LinkedIn URL of the project owner, shown on /contact when set
CONTACT_LINKEDIN=

# Live: GrabExpress (parcels) and Grab ride estimates (Partner Farefeed). Both off by default; see docs/operations.md.
# A feature that is on refuses to start without its credentials. No real values here.
GRAB_ENV=sandbox
GRAB_EXPRESS=off
GRAB_FAREFEED=off
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
# Optional separate Farefeed client (defaults to GRAB_CLIENT_*)
# GRAB_FAREFEED_CLIENT_ID=
# GRAB_FAREFEED_CLIENT_SECRET=
GRAB_EXPRESS_SERVICE_TYPE=INSTANT
GRAB_EXPRESS_VEHICLES=BIKE,CAR,VAN
# cash: sender pays the courier (paymentMethod CASH, payer SENDER); cashless: billed to Unyly, pair with GrabPay
# cashless: the user pays with GrabPay before the delivery is created; needs GRABPAY=on with GRABPAY_CURRENCY of GRAB_EXPRESS_REGION
GRAB_EXPRESS_PAYMENT=cash
# Grab market of the GrabExpress account (sets the expected quote currency, TH = THB)
# GRAB_EXPRESS_REGION=TH
# Secret Grab sends in the Authorization header of tracking webhooks (openssl rand -hex 32). Required with GRAB_EXPRESS=on.
GRAB_EXPRESS_WEBHOOK_AUTH=
# GRAB_EXPRESS_WEBHOOK_AUTH_ID=
# GRAB_EXPRESS_UNKNOWN_CANCEL_AFTER_SEC=600
# GRAB_HTTP_TIMEOUT_MS=8000
# GRAB_RPS=5
